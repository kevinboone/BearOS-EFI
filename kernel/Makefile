include ../config.mak

# Indicate where the gni-efi dev components are located. These settings
#   are appropriate for Debian, but may need to be changed for other
#   Linux variants
EFI_LIB        = /usr/lib
GNU_EFI_LIB    = /usr/lib
EFI_LDS_BASE   = /usr/lib
EFI_LDS        = $(EFI_LDS_BASE)/elf_$(ARCH)_efi.lds
EFI_INCS       = /usr/include
EFI_CRT_OBJS   = $(GNU_EFI_LIB)/crt0-efi-$(ARCH).o

# For example, if you're using the source distribution of gnu-efi, these
#   settings might be appropriate
#EFI_LIB        = $(HOME)/lib/gnu-efi-master/x86_64/lib
#GNU_EFI_LIB    = $(HOME)/lib/gnu-efi-master/x86_64/gnuefi
#EFI_LDS_BASE   = $(HOME)/lib/gnu-efi-master/gnuefi
#EFI_LDS        = $(EFI_LDS_BASE)/elf_$(ARCH)_efi.lds
#EFI_INCS       = $(HOME)/lib/gnu-efi-master/inc 
#EFI_CRT_OBJS   = $(GNU_EFI_LIB)/crt0-efi-$(ARCH).o

LIB_INCS       = ../lib/include


# -DEFI_FUNCTION_WRAPPER makes uefi_call_wrapper behave appropriately for
#   a 64-bit compiler
# -fno-stack-protector and -mno-red-zone set up stack handling appropriate
#   for EFI
# -fpic generates position-independent code
# -fshort-char makes strings like L"foo" UTF16 rather than GCC's default
#   UTF32. EFI uses 2-byte unicode characters 
CFLAGS         = -I $(EFI_INCS) -I $(LIB_INCS) \
		-DEFI_FUNCTION_WRAPPER -fno-stack-protector -fpic \
		-fshort-wchar -mno-red-zone -Wall \
                 -fno-builtin-realloc 

# -nostdlib -- naturally, no standard library
# -znocombreloc -- we don't need to optimize for dynamic symbol relocation
# -T specifies the architecture-specific linker script, which is part of
#   gnu-efi
# -shared -- generate a .so
# -Bsymbolic -- bind symbol references to their global definitions
LDFLAGS        = -nostdlib -znocombreloc -T $(EFI_LDS) -shared \
		  -Bsymbolic -L $(EFI_LIB) -L $(GNU_EFI_LIB) $(EFI_CRT_OBJS)

# Work out the objects and sources from the src/ directory, rather than specifying
#  them explicitly in the Makefile
SOURCES        := $(sort $(shell find src/ -type f -name *.c))
OBJECTS        := $(patsubst src/%,build/%,$(SOURCES:.c=.o))

all: prepare build/bearos.efi 

build/%.o: src/%.c
	@mkdir -p build/
	gcc $(CFLAGS) -MD -MF $(@:.o=.deps) -c -o $@ $< 

build/kernel.so: $(OBJECTS) 
	ld $(LDFLAGS) -o build/kernel.so $(OBJECTS) -lefi -lgnuefi

# We will make the EFI executable by transforming the 
#  .so file generated by ld using the Binary File Definition (BFD) for
#  the EFI architecture we're building. We'll also pick out only the
#  relevant sections, to keep the size under control
build/bearos.efi: build/kernel.so
	objcopy -j .text -j .sdata -j .data -j .dynamic \
		-j .dynsym  -j .rel -j .rela -j .reloc \
		--target=efi-app-$(ARCH) build/kernel.so build/bearos.efi 


# Use xorriso to build an ISO9660 image that can be burned to a DVD or USB
#   stick. The -e switch sets bearos.img, the virtual floppy, as the embedded
#   boot image
bearos.iso: build/bearos.img
	mkdir -p img/
	cp build/bearos.img img/
	xorriso -as mkisofs -V hello -o bearos.iso -eltorito-platform efi -e bearos.img -no-emul-boot img/

prepare:
	mkdir -p build/

clean:
	rm -rf bearos.iso build/ img/ bearos 


